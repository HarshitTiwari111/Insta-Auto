# ---------- Copy this file to .env and fill values ----------

NODE_ENV=development

# Postgres + Redis (docker-compose defaults)
DATABASE_URL=postgresql://instaauto:instaauto@localhost:5432/instaauto
REDIS_URL=redis://localhost:6379

# Public URL of the PWA (Next.js). Used for redirects after Instagram connect.
APP_URL=http://localhost:3000
# Public HTTPS URL of the API server. Meta needs HTTPS for OAuth redirect + webhooks.
# In local dev use a tunnel (cloudflared / ngrok) and put that https URL here.
API_PUBLIC_URL=https://your-tunnel.example.com
# Where the Next.js server proxies /api/* to (server-side only)
API_URL=http://localhost:4000
PORT=4000

# Meta app > Instagram > API setup with Instagram login
# instagram = Business Login for Instagram (Instagram app ID/secret)
# facebook  = Facebook Login (Facebook app ID/secret from App settings > Basic; IG account must be linked to a Facebook Page)
IG_LOGIN_MODE=instagram
IG_APP_ID=
IG_APP_SECRET=
IG_API_VERSION=v26.0
# Any random string; paste the same value in Meta app webhook settings
IG_WEBHOOK_VERIFY_TOKEN=

# 32 random bytes, base64. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

SESSION_TTL_DAYS=7

# Web Push (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Comment polling fallback (minutes). 0 = off.
# Meta docs: comment webhooks need Advanced Access. Until approved, polling keeps comment automation working.
COMMENT_POLL_MINUTES=2

# Windows with an antivirus that scans HTTPS (Avast, Kaspersky...): uncomment so Node trusts the system certificate store
# NODE_OPTIONS=--use-system-ca

# Google Gemini for AI replies (https://aistudio.google.com/api-keys). Empty = AI off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
