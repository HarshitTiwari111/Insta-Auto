// Instaauto database schema (PostgreSQL)

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum RuleTrigger {
  COMMENT
  DM
}

enum MatchType {
  ANY
  KEYWORD
}

enum PostType {
  IMAGE
  REELS
  STORY
  CAROUSEL
}

enum PostStatus {
  /// Saved but not queued; never published until scheduled
  DRAFT
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

/// How the account was connected (decides API host and token type)
enum AuthType {
  /// Business Login for Instagram: graph.instagram.com, IG user token (60 days, refreshable)
  INSTAGRAM
  /// Facebook Login: graph.facebook.com, Page token (no expiry) of the linked Facebook Page
  FACEBOOK
}

enum Direction {
  IN
  OUT
}

/// Team member who can log in to the PWA
model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  passwordHash      String
  role              Role               @default(MEMBER)
  createdAt         DateTime           @default(now())
  pushSubscriptions PushSubscription[]
}

/// Connected Instagram professional (Business/Creator) account
model IgAccount {
  id                 String           @id @default(cuid())
  /// Instagram professional account ID (`user_id` from GET /me). Same as webhook entry.id
  igUserId           String           @unique
  username           String
  accountType        String?
  profilePictureUrl  String?
  authType           AuthType         @default(INSTAGRAM)
  /// FACEBOOK only: Facebook Page linked to this Instagram account (DMs and webhook subscription go through it)
  pageId             String?
  /// Long-lived token, AES-256-GCM encrypted. Never returned by the API.
  accessTokenEnc     String
  tokenExpiresAt     DateTime
  tokenRefreshedAt   DateTime
  /// Emergency stop for this account (no automated actions, no publishing)
  paused             Boolean          @default(false)
  /// Max automated actions (replies, hides, DMs) per UTC day
  dailyActionLimit   Int              @default(500)
  /// Max automated actions per hour; extra events wait for the next hour
  hourlyActionLimit  Int              @default(60)
  /// Working hours (local hour 0-23, in `timezone`). Both null = always on. Events outside wait for the start.
  workStartHour      Int?
  workEndHour        Int?
  timezone           String           @default("Asia/Kolkata")
  /// AI checks every new comment and hides spam (before any rule runs)
  aiSpamFilter       Boolean          @default(false)
  /// fast = reply at once; medium / slow = wait a random 20-60 s / 1-3 min first (looks human)
  replySpeed         String           @default("fast")
  /// Blacklisted Instagram usernames (lowercase, no @): never auto-replied to
  blocklist          String[]         @default([])
  /// Also hide comments from blacklisted usernames
  blocklistHide      Boolean          @default(false)
  webhooksSubscribed Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  rules              AutomationRule[]
  posts              ScheduledPost[]
  messages           DmMessage[]
  activity           ActivityLog[]
  stats              AccountStat[]
  flows              DmFlow[]
}

/// DM chatbot: keyword starts it, each step = message + buttons, each button points to the next step
model DmFlow {
  id        String    @id @default(cuid())
  accountId String
  account   IgAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  enabled   Boolean   @default(true)
  /// Case-insensitive "contains" match on the person's message
  keywords  String[]
  /// [{ id, text, buttons: [{ title, next: stepId | null }] }]; the first step starts the flow
  steps     Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([accountId, enabled])
}

/// Daily profile numbers (one row per account per UTC day, last value of the day wins) for growth charts
model AccountStat {
  id         String    @id @default(cuid())
  accountId  String
  account    IgAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// UTC date, YYYY-MM-DD
  day        String
  followers  Int
  follows    Int?
  mediaCount Int
  updatedAt  DateTime  @updatedAt

  @@unique([accountId, day])
}

/// "When a comment/DM matches X, do Y"
model AutomationRule {
  id                    String      @id @default(cuid())
  accountId             String
  account               IgAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                  String
  enabled               Boolean     @default(true)
  trigger               RuleTrigger
  matchType             MatchType   @default(KEYWORD)
  /// Case-insensitive "contains" match. Used when matchType = KEYWORD
  keywords              String[]
  /// COMMENT only: run only on these posts/reels (empty = all posts)
  mediaIds              String[]    @default([])
  /// COMMENT: public reply under the comment. DM: reply message. One is picked at random (rotation).
  replyTemplates        String[]
  /// COMMENT only: one private DM to the commenter (Meta allows 1 per comment, within 7 days)
  privateReplyTemplates String[]
  /// COMMENT only: hide the comment (spam / blacklist words)
  hideComment           Boolean     @default(false)
  /// COMMENT only: delete the comment (spam). Takes precedence over hide/reply.
  deleteComment         Boolean     @default(false)
  /// DM only: quick reply buttons sent with the reply (max 13, title max 20 chars)
  quickReplies          String[]
  /// DM only: photo / video sent after the text reply (one of our uploads or a public URL)
  replyMediaUrl         String?
  /// Public reply (COMMENT) / DM reply (DM) written by AI. replyTemplates become the fallback.
  aiReply               Boolean     @default(false)
  /// What the AI should know: business info, tone, what to say or never say
  aiInstructions        String?
  /// Lower number = checked first
  priority              Int         @default(100)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([accountId, trigger, enabled])
}

model ScheduledPost {
  id          String     @id @default(cuid())
  accountId   String
  account     IgAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        PostType
  /// Publicly reachable URLs. Images must be JPEG (Meta requirement). CAROUSEL: 2-20 items.
  mediaUrls   String[]
  caption     String?
  /// Posted as the first comment right after publishing (e.g. hashtags)
  firstComment String?
  scheduledAt DateTime
  status      PostStatus @default(PENDING)
  igMediaId   String?
  /// Auto-delete: remove the published post from Instagram at this time
  deleteAt    DateTime?
  /// Set once the post was removed from Instagram by auto-delete
  deletedAt   DateTime?
  error       String?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, scheduledAt])
  @@index([accountId, scheduledAt])
}

/// Uploaded media kept in the database (UPLOAD_STORAGE=db), for hosts without a persistent disk
model MediaFile {
  /// Same random name as in the public URL: <32 hex>.jpg|mp4|mov
  name      String   @id
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
}

/// Reusable reply texts (DM / comment replies), inserted into rules from a library
model MessageTemplate {
  id        String   @id @default(cuid())
  name      String
  text      String
  createdAt DateTime @default(now())
}

/// Saved hashtag groups, inserted into captions / first comments
model HashtagSet {
  id        String   @id @default(cuid())
  name      String
  tags      String
  createdAt DateTime @default(now())
}

model DmMessage {
  id        String    @id @default(cuid())
  accountId String
  account   IgAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Instagram-scoped ID of the other person
  igsid     String
  /// Their @username when known (DMs only carry the IGSID; filled from the comment or a profile lookup)
  username  String?
  direction Direction
  text      String?
  /// Meta message id; unique so webhook retries / echoes never duplicate
  mid       String?   @unique
  ruleId    String?
  createdAt DateTime  @default(now())

  @@index([accountId, igsid, createdAt])
  @@index([accountId, createdAt])
}

model ActivityLog {
  id        String     @id @default(cuid())
  accountId String?
  account   IgAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// e.g. comment.reply, comment.hide, comment.private_reply, dm.reply, post.published, error
  kind      String
  detail    Json?
  createdAt DateTime   @default(now())

  @@index([accountId, createdAt])
  @@index([createdAt])
}

/// Raw webhook log (Meta keeps no history; retried for up to 36h)
model WebhookEvent {
  id          String    @id @default(cuid())
  igUserId    String
  field       String
  dedupeKey   String    @unique
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([receivedAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
